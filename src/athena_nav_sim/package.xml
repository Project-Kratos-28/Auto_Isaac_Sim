<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>athena_nav_sim</name>
  <version>0.0.0</version>
  <description>Runs the Kratos autonomy stack (GLIM + waypoint_manager, pcd2pgm, Nav2) against the Isaac Sim digital twin</description>
  <maintainer email="aarshbhatt2007@gmail.com">aarsh</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>action_msgs</depend>

  <exec_depend>glim_ros</exec_depend>
  <exec_depend>waypoint_manager</exec_depend>
  <exec_depend>pcd2pgm</exec_depend>
  <exec_depend>kratos_nav</exec_depend>
  <depend>tf2_ros</depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
