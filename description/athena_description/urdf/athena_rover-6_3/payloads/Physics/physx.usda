"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "athena_rover"
{
    over "Physics"
    {
        over "bogey_left_pivot" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.1
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "bogey_right_pivot" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.1
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "steer_front_left" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.05
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "wheel_front_left_spin" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.05
        }

        over "steer_rear_left" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.05
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "wheel_rear_left_spin" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.05
        }

        over "steer_front_right" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.05
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "wheel_front_right_spin" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.05
        }

        over "steer_rear_right" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.05
            float physxJoint:maxJointVelocity = 57.29578
        }

        over "wheel_rear_right_spin" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.05
        }
    }
}

