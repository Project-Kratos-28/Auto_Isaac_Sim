#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "athena_rover"
    doc = """Generated from Composed Stage of root layer /tmp/tmpiordw69s/athena_rover.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_athena_rover-6_0hoe_zuy/usdex_athena_rover-6/athena_rover.usdc


