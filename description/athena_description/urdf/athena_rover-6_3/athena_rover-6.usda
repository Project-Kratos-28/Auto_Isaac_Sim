                    {
                        matrix4d xformOp:transform = ( (-1.7763568394002517e-17, 0.010000000000000007, 4.996003610813208e-18, 0), (1.8318679906315084e-17, -4.440892098500626e-18, 0.01, 0), (0.010000000000000005, 1.8318679906315093e-17, -1.7763568394002514e-17, 0), (0.5965788752696939, 0.9044328695082322, 0.1777658183649354, 1) )
