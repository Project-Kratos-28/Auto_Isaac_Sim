#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "chassis" (
        prepend references = @./geometries.usd@</Geometries/chassis>
    )
    {
        over "chassis" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/chassis/VisualMaterials/aluminium>
        }

        def Scope "VisualMaterials"
        {
            def Material "aluminium" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/aluminium>
            )
            {
            }
        }
    }

    def Xform "chassis_1" (
        prepend references = @./geometries.usd@</Geometries/chassis>
    )
    {
        over "chassis" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

    def Xform "bogey_arm" (
        prepend references = @./geometries.usd@</Geometries/bogey_arm>
    )
    {
        over "bogey_arm" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/bogey_arm/VisualMaterials/aluminium>
        }

        def Scope "VisualMaterials"
        {
            def Material "aluminium" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/aluminium>
            )
            {
            }
        }
    }

    def Xform "bogey_arm_1" (
        prepend references = @./geometries.usd@</Geometries/bogey_arm>
    )
    {
        over "bogey_arm" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

    def Xform "SteeringMotorHousing" (
        prepend references = @./geometries.usd@</Geometries/SteeringMotorHousing>
    )
    {
        over "SteeringMotorHousing" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/SteeringMotorHousing/VisualMaterials/motor_grey>
        }

        def Scope "VisualMaterials"
        {
            def Material "motor_grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/motor_grey>
            )
            {
            }
        }
    }

    def Xform "SteeringMotorHousing_1" (
        prepend references = @./geometries.usd@</Geometries/SteeringMotorHousing>
    )
    {
        over "SteeringMotorHousing" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

    def Xform "stearing" (
        prepend references = @./geometries.usd@</Geometries/stearing>
    )
    {
        over "stearing" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/stearing/VisualMaterials/motor_grey>
        }

        def Scope "VisualMaterials"
        {
            def Material "motor_grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/motor_grey>
            )
            {
            }
        }
    }

    def Xform "stearing_1" (
        prepend references = @./geometries.usd@</Geometries/stearing>
    )
    {
        over "stearing" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

    def Xform "wheel" (
        prepend references = @./geometries.usd@</Geometries/wheel>
    )
    {
        over "wheel" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/wheel/VisualMaterials/rubber>
        }

        def Scope "VisualMaterials"
        {
            def Material "rubber" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/rubber>
            )
            {
            }
        }
    }
}

