        def PhysicsRevoluteJoint "steer_front_left" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 10
            float newton:damping = 0.0034906585
            float newton:friction = 0.05
            float newton:velocityLimit = 57.29578
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </athena_rover/Geometry/base_footprint/base_link/bogey_left/steer_housing_front_left>
