#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "athena_rover"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "athena_rover"
{
    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.4, 0.18, 0.5, 0, 0, 0]
                bool newton:selfCollisionEnabled = 0
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.18, 0.4, 0.5)
                float physics:mass = 8
                quatf physics:principalAxes = (6.123234e-17, 0.70710677, 0.70710677, 0)

                over "bogey_left" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [0.03, 0.002, 0.03, 0, 0, 0]
                    point3f physics:centerOfMass = (0, 0.275, 0)
                    float3 physics:diagonalInertia = (0.002, 0.03, 0.03)
                    float physics:mass = 1.2
                    quatf physics:principalAxes = (6.123234e-17, 0.70710677, 0.70710677, 0)

                    over "steer_housing_front_left" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                    )
                    {
                        double[] newton:inertia = [0.0001, 0.0001, 0.00005, 0, 0, 0]
                        float3 physics:diagonalInertia = (0.00005, 0.0001, 0.0001)
                        float physics:mass = 0.2
                        quatf physics:principalAxes = (-0.5, 0.5, 0.5, 0.5)

                        over "steer_coupler_front_left" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                        )
                        {
                            double[] newton:inertia = [0.0001, 0.0001, 0.00005, 0, 0, 0]
                            float3 physics:diagonalInertia = (0.00005, 0.0001, 0.0001)
                            float physics:mass = 0.15
                            quatf physics:principalAxes = (-0.5, 0.5, 0.5, 0.5)

                            over "wheel_front_left" (
                                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                            )
                            {
                                double[] newton:inertia = [0.006, 0.01, 0.006, 0, 0, 0]
                                float3 physics:diagonalInertia = (0.006, 0.006, 0.01)
                                float physics:mass = 0.8
                                quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                                over "cylinder" (
                                    prepend apiSchemas = ["NewtonCollisionAPI"]
                                )
                                {
                                }
                            }
                        }
                    }

                    over "steer_housing_rear_left" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                    )
                    {
                        double[] newton:inertia = [0.0001, 0.0001, 0.00005, 0, 0, 0]
