            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -45.263664
            float physics:upperLimit = 45.263664
            custom float urdf:limit:effort = 10
        }

