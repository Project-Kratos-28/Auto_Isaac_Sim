    over "Physics"
    {
        def PhysicsRevoluteJoint "bogey_left_pivot" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float newton:damping = 0.008726646
            float newton:friction = 0.1
            float newton:velocityLimit = 57.29578
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </athena_rover/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </athena_rover/Geometry/base_footprint/base_link/bogey_left>
            point3f physics:localPos0 = (0, 0.275, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -30.00007
            float physics:upperLimit = 30.00007
            custom float urdf:limit:effort = 0
        }

        def PhysicsRevoluteJoint "bogey_right_pivot" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
