#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "athena_rover"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "athena_rover" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </athena_rover/Physics/bogey_left_pivot>,
        </athena_rover/Physics/bogey_right_pivot>,
        </athena_rover/Physics/steer_housing_mount_front_left>,
        </athena_rover/Physics/steer_housing_mount_rear_left>,
        </athena_rover/Physics/steer_front_left>,
        </athena_rover/Physics/wheel_front_left_spin>,
        </athena_rover/Physics/steer_rear_left>,
        </athena_rover/Physics/wheel_rear_left_spin>,
        </athena_rover/Physics/steer_housing_mount_front_right>,
        </athena_rover/Physics/steer_housing_mount_rear_right>,
        </athena_rover/Physics/steer_front_right>,
        </athena_rover/Physics/wheel_front_right_spin>,
        </athena_rover/Physics/steer_rear_right>,
        </athena_rover/Physics/wheel_rear_right_spin>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </athena_rover/Geometry/base_footprint/base_link>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_left>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_left/steer_housing_front_left>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_left/steer_housing_front_left/steer_coupler_front_left>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_left/steer_housing_front_left/steer_coupler_front_left/wheel_front_left>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_left/steer_housing_rear_left>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_left/steer_housing_rear_left/steer_coupler_rear_left>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_left/steer_housing_rear_left/steer_coupler_rear_left/wheel_rear_left>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_right>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_right/steer_housing_front_right>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_right/steer_housing_front_right/steer_coupler_front_right>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_right/steer_housing_front_right/steer_coupler_front_right/wheel_front_right>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_right/steer_housing_rear_right>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_right/steer_housing_rear_right/steer_coupler_rear_right>,
        </athena_rover/Geometry/base_footprint/base_link/bogey_right/steer_housing_rear_right/steer_coupler_rear_right/wheel_rear_right>,
    ]
    token isaac:robotType = "Wheeled"

    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "bogey_left" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "steer_housing_front_left" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "steer_coupler_front_left" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "wheel_front_left" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }

                    over "steer_housing_rear_left" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "steer_coupler_rear_left" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "wheel_rear_left" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }
                }

                over "bogey_right" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "steer_housing_front_right" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "steer_coupler_front_right" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "wheel_front_right" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }

                    over "steer_housing_rear_right" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "steer_coupler_rear_right" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "wheel_rear_right" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "bogey_left_pivot" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "bogey_right_pivot" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_housing_mount_front_left" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_front_left" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_front_left_spin" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_housing_mount_rear_left" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_rear_left" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_rear_left_spin" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_housing_mount_front_right" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_front_right" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_front_right_spin" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_housing_mount_rear_right" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_rear_right" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_rear_right_spin" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

